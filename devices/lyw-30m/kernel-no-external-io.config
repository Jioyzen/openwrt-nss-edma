# LYW-30M has SPI NAND, no MMC/eMMC and no external USB ports.
# Keep shared PCIe/USB UNIPHY, Ethernet UNIPHY, NAND, NVMEM and WCSS.
# This fragment is applied only to a single LYW-30M device profile.
# CONFIG_MMC is not set
# CONFIG_MMC_BLOCK is not set
# CONFIG_MMC_CQHCI is not set
# CONFIG_MMC_SDHCI is not set
# CONFIG_MMC_SDHCI_MSM is not set
# CONFIG_MMC_SDHCI_PLTFM is not set
# CONFIG_USB_SUPPORT is not set
# CONFIG_USB is not set
# CONFIG_USB_GADGET is not set
# CONFIG_PHY_QCOM_QMP_USB is not set
# CONFIG_PHY_QCOM_QUSB2 is not set
