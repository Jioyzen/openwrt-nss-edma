#!/bin/sh
G=/sys/class/leds/green:network
R=/sys/class/leds/red:power
STATE=/tmp/lyw-internet-state

set_led() {
	local led=$1 value=$2
	[ -d "$led" ] || return 0
	echo none > "$led/trigger" 2>/dev/null
	echo "$value" > "$led/brightness" 2>/dev/null
}

online=0
# Follow the default route's egress in both router and bridged AP modes.
# Route/link notifications trigger this check; it sends no probe packets.
for dev in $(ip -4 route show default 2>/dev/null | awk '{for (i=1; i<NF; i++) if ($i == "dev") print $(i+1)}'); do
	[ "$(cat "/sys/class/net/$dev/carrier" 2>/dev/null)" = 1 ] || continue
	online=1
	break
done
if [ "$online" = 1 ]; then
	set_led "$R" 0
	set_led "$G" 1
	now=online
else
	set_led "$G" 0
	set_led "$R" 1
	now=offline
fi
last="$(cat "$STATE" 2>/dev/null)"
if [ "$now" != "$last" ]; then
	echo "$now" > "$STATE"
	logger -t lyw-led "Internet state: $now"
fi
