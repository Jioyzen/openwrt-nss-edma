#!/bin/sh /etc/rc.common

START=96
USE_PROCD=1

start_service() {
	# Until the first successful check, show the fault color.
	echo none > /sys/class/leds/green:network/trigger 2>/dev/null
	echo 0 > /sys/class/leds/green:network/brightness 2>/dev/null
	echo none > /sys/class/leds/red:power/trigger 2>/dev/null
	echo 1 > /sys/class/leds/red:power/brightness 2>/dev/null
	procd_open_instance
	procd_set_param command /usr/sbin/lyw-led-monitor
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	# Keep the fault colour on through shutdown/reboot.
	echo none > /sys/class/leds/green:network/trigger 2>/dev/null
	echo 0 > /sys/class/leds/green:network/brightness 2>/dev/null
	echo none > /sys/class/leds/red:power/trigger 2>/dev/null
	echo 1 > /sys/class/leds/red:power/brightness 2>/dev/null
}
