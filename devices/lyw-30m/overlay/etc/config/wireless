config wifi-device 'radio2g'
	option type 'mac80211'
	option path 'platform/soc@0/c000000.wifi'
	option band '2g'
	option country 'CN'
	option channel 'auto'
	option htmode 'HE20'
	option disabled '0'

config wifi-iface 'ap2g'
	option device 'radio2g'
	option network 'lan'
	option mode 'ap'
	option ssid 'LYW-2.4G'
	option encryption 'none'
	option maxassoc '32'
	option disabled '0'

config wifi-device 'radio5g'
	option type 'mac80211'
	option path 'platform/soc@0/b00a040.wifi'
	option band '5g'
	option country 'CN'
	option channel 'auto'
	option htmode 'HE80'
	option disabled '0'

config wifi-iface 'ap5g'
	option device 'radio5g'
	option network 'lan'
	option mode 'ap'
	option ssid 'LYW-5G'
	option encryption 'none'
	option maxassoc '32'
	option disabled '0'
