#!/bin/sh
# Initialize once; an existing password survives upgrades and ordinary boots.
[ "$(cat /tmp/sysinfo/board_name)" = 'lingyan,lyw-30m' ] || exit 1
hash=$(awk -F: '$1 == "root" { print $2 }' /etc/shadow)
case "$hash" in
 ''|'!'|'*'|'!!') ;;
 *) exit 0 ;;
esac
umask 077
password='password'
printf '%s\n%s\n' "$password" "$password" | passwd root >/dev/null 2>&1 || exit 1
printf '%s\n' "$password" > /tmp/lyw-web-password
exit 0
