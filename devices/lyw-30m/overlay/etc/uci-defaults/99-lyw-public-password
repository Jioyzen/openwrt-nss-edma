#!/bin/sh
# Public initial password; preserve an existing password on upgrades.
[ "$(cat /tmp/sysinfo/board_name 2>/dev/null)" = 'lingyan,lyw-30m' ] || exit 0
hash="$(awk -F: '$1 == "root" { print $2 }' /etc/shadow)"
case "$hash" in ''|'!'|'*') printf '%s\n' 'root:password' | chpasswd ;; esac
exit 0
