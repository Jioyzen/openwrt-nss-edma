From: LYW-30M RAM bring-up <local@localhost>
Subject: [PATCH] remoteproc: qcom: bound one-based WCSS user PD indices

IPQ5018 names user protection domains 1 through 3. Reserve index zero
and reject indices outside that range before storing a user PD pointer.
Existing iteration already uses ARRAY_SIZE, so it includes domain 3.

--- a/drivers/remoteproc/qcom_q6v5_mpd.c
+++ b/drivers/remoteproc/qcom_q6v5_mpd.c
@@ -86,7 +86,7 @@
 	int num_clks;
 	const struct wcss_data *desc;
 	const char **firmware;
-	struct userpd *upd[MAX_UPD];
+	struct userpd *upd[MAX_UPD + 1];
 };
 
 struct userpd {
@@ -650,6 +650,8 @@
 
 	/* Get pd_asid to prepare interrupt names */
 	upd->pd_asid = qcom_get_pd_asid(rproc);
+	if (!upd->pd_asid || upd->pd_asid > MAX_UPD)
+		return -EINVAL;
 
 	ret = q6_get_inbound_irq(q6, pdev, "fatal", 0, &q6->fatal_irq,
 				 q6v5_fatal_interrupt);
